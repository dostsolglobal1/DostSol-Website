# Copy to server/.env
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/dostsol
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Optional SMTP — leave blank to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DostSol Global <no-reply@dostsol.com>"
MAIL_TO=info@dostsol.com

# Seed admin
ADMIN_EMAIL=admin@dostsol.com
ADMIN_PASSWORD=ChangeMe123!
